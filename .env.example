# Django backend, including the /api/v1 prefix.
# Dev:  http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=

# WebSocket origin. Derived from NEXT_PUBLIC_API_URL when unset.
# Dev:  ws://localhost:8000
NEXT_PUBLIC_WS_URL=

# Public site origin, used for metadata and share URLs.
# Prod: https://cybercraft.uz
NEXT_PUBLIC_SITE_URL=

# Google OAuth client id. Must match GOOGLE_CLIENT_ID in the backend .env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Telegram bot username, without the leading @.
# Must correspond to TELEGRAM_BOT_TOKEN in the backend .env.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
